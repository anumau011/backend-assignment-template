{
  "info": {
    "_postman_id": "c1f2e3d4-5678-90ab-cdef-1234567890ab",
    "name": "Waygood Study Abroad Evaluation API",
    "description": "Postman collection covering Authentication, University Discovery, Program Discovery, Recommendation Engine, Groq AI Recommendations & Study Plan, and Application Workflow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "programId",
      "value": "",
      "type": "string"
    },
    {
      "key": "applicationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Check Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Candidate Student\",\n  \"email\": \"candidate.student@example.com\",\n  \"password\": \"Candidate123!\",\n  \"role\": \"student\",\n  \"targetCountries\": [\"Canada\", \"UAE\"],\n  \"interestedFields\": [\"Computer Science\"],\n  \"preferredIntake\": \"September\",\n  \"maxBudgetUsd\": 24000,\n  \"englishTest\": {\n    \"exam\": \"IELTS\",\n    \"score\": 7.0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aarav@example.com\",\n  \"password\": \"Candidate123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "AI Platform Services",
      "item": [
        {
          "name": "AI Recommendations (Groq)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preferredCountry\": \"Canada\",\n  \"budget\": 30000,\n  \"field\": \"Computer Science\",\n  \"intake\": \"Fall\",\n  \"ielts\": 7,\n  \"cgpa\": 8.2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/recommend",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "recommend"]
            }
          }
        },
        {
          "name": "AI Study Plan Roadmap (Groq)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country\": \"Canada\",\n  \"targetIntake\": \"Fall 2027\",\n  \"currentIELTS\": 6,\n  \"targetIELTS\": 7,\n  \"cgpa\": 8.2,\n  \"documentsUploaded\": [\"Passport\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/study-plan",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "study-plan"]
            }
          }
        }
      ]
    },
    {
      "name": "Universities",
      "item": [
        {
          "name": "List Universities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/universities?country=Canada&page=1&limit=10&sortBy=ranking",
              "host": ["{{baseUrl}}"],
              "path": ["universities"],
              "query": [
                { "key": "country", "value": "Canada" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "ranking" }
              ]
            }
          }
        },
        {
          "name": "List Popular Universities (Cached)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/universities/popular",
              "host": ["{{baseUrl}}"],
              "path": ["universities", "popular"]
            }
          }
        }
      ]
    },
    {
      "name": "Programs",
      "item": [
        {
          "name": "List Programs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/programs?degreeLevel=master&maxTuition=25000&sortBy=tuitionAsc",
              "host": ["{{baseUrl}}"],
              "path": ["programs"],
              "query": [
                { "key": "degreeLevel", "value": "master" },
                { "key": "maxTuition", "value": "25000" },
                { "key": "sortBy", "value": "tuitionAsc" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Get Recommendations (Aggregation)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations", "{{studentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "List Applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Apply to Program",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programId\": \"{{programId}}\",\n  \"intake\": \"September\",\n  \"note\": \"Applying via Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Update Application Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"submitted\",\n  \"note\": \"Submitted SOP and transcript\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "status"]
            }
          }
        }
      ]
    }
  ]
}
